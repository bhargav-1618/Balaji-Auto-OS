# Firebase Configuration
# Copy these verbatim from Firebase Console > Project Settings > Your Apps > Web App
# (the `firebaseConfig` object). Do not hand-construct them — the storage bucket, in
# particular, is `<project>.firebasestorage.app` for newer projects and
# `<project>.appspot.com` for older ones. All six are required; the app fails fast if
# any is missing. These are public client keys, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional. A stable public origin (e.g. https://your-app.example.com) baked into the QR
# code printed on invoice/job-card PDFs. Without it, the QR falls back to the request's
# origin at generation time, then to a hardcoded production domain as a last resort.
# See lib/pdfQr.js for the full fallback order.
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# Optional. Workshop identity printed on the PDF letterhead (Job Card/Invoice/Purchase
# Order/Reports) and used as the Settings > Business Profile placeholder — see
# lib/pdfTheme.js's SHOP constant. These are public configuration (the same info a
# workshop already prints on every paper invoice it hands a customer), not secrets;
# they're env vars only to keep one specific workshop's real contact details out of
# this public repository. Unset, the app falls back to generic placeholder text.
# NEXT_PUBLIC_SHOP_NAME=Your Workshop Name
# NEXT_PUBLIC_SHOP_TAGLINE=Automotive Service & Diagnostics
# NEXT_PUBLIC_SHOP_PHONES=00000 00000
# NEXT_PUBLIC_SHOP_ADDRESS=Your workshop address, city, state, PIN
# NEXT_PUBLIC_SHOP_GST=22AAAAA0000A1Z5
# NEXT_PUBLIC_SHOP_EMAIL=contact@example.com
# NEXT_PUBLIC_SHOP_WEBSITE=example.com
