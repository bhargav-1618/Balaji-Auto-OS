rules_version = '2';

// =============================================================================
// HARDENED RULESET — this is the active security boundary. Deploy it to your
// Firebase project ("firebase deploy --only firestore:rules"); rules do nothing
// until published. (The reference deployment, project balaji-auto-os-7, has it
// published.)
// -----------------------------------------------------------------------------
// If you change this file, re-verify in Firebase Console > Firestore > Rules >
// "Rules playground" with (a) the owner email, (b) a staff email, (c) an
// unauthenticated request, running read / create / update / delete against each
// collection before publishing. If the owner ever loses access, revert to the
// previous ruleset from the Rules history and re-test.
//
// WHAT THIS CHANGES vs a plain `request.auth != null`-everywhere ruleset:
//
//  1. PRIVILEGE-ESCALATION FIX (highest value): appSettings is now WRITABLE ONLY
//     BY ADMINS. Under the old rules any signed-in staff member could edit
//     appSettings/roles via the REST API / console and add their own email to
//     `admins[]`, promoting themselves. That hole is closed here.
//
//  2. DESTRUCTIVE OPS ARE ADMIN-ONLY: delete on parts/suppliers/categories/
//     vehicles and on the ledgers is restricted to admins, matching what the UI
//     already enforces — so a staff token can't delete via console/REST.
//
//  3. Ledgers stay append-only (update: false) exactly as before.
//
// ASSUMPTIONS (still true; re-verify if you touch the role model):
//  - The owner email below matches BOOTSTRAP_ADMINS in context/AuthContext.js.
//  - appSettings/roles stores `admins` as an array of LOWERCASE emails (the app
//    normalizes with norm() on read; confirm the Settings WRITE path also stores
//    lowercase, or these comparisons can miss). request.auth.token.email.lower()
//    is compared against that list.
//  - Every signed-in user is trusted to READ all shop data (single-shop model).
//    If you later need multi-tenant isolation, reads must also be scoped.
//
// COST NOTE: isAdmin() does a get() on appSettings/roles, which is billed as one
// document read per evaluated write. For this app's volume that is negligible.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // Permanent owner — always admin, mirrors BOOTSTRAP_ADMINS so the owner can
    // never be locked out even if appSettings/roles is empty or missing.
    function ownerEmail() {
      return 'konabhargav2003@gmail.com';
    }

    function rolesDoc() {
      return get(/databases/$(database)/documents/appSettings/roles).data;
    }

    function isAdmin() {
      return signedIn() && (
        userEmail() == ownerEmail() ||
        (
          exists(/databases/$(database)/documents/appSettings/roles) &&
          'admins' in rolesDoc() &&
          userEmail() in rolesDoc().admins
        )
      );
    }

    // ---- Catalog data: any signed-in user reads/creates/updates; only admins delete.
    match /parts/{partId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /suppliers/{supplierId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    // ---- Operational business records: customers, invoices, job cards.
    // Signed-in staff create/update; only admins delete.
    match /customers/{customerId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /invoices/{invoiceId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /jobCards/{jobCardId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
    // ---- Purchase Orders: signed-in users create/advance; only admins delete.
    // Status transitions (pending→approved→received→cancelled) are updates.
    match /purchaseOrders/{poId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // ---- History ledgers: append-only. Records can never be EDITED.
    // delete is admin-only (used by the owner-only "Reset All Data", which
    // snapshots to the Recovery Vault first).
    match /sales/{saleId} {
      allow read, create: if signedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /salesRollups/{month} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
    match /restocks/{restockId} {
      allow read, create: if signedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /stockAdjustments/{adjId} {
      allow read, create: if signedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /auditLog/{logId} {
      allow read, create: if signedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Reorder requests / purchase tracking: status changes over time.
    match /reorderRequests/{reqId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // ---- App settings (admin/staff lists). READ by any signed-in user (the app
    // needs it to resolve roles), but WRITE is ADMIN-ONLY. This is the
    // privilege-escalation fix: staff can no longer grant themselves admin.
    match /appSettings/{docId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- Recovery Vault — owner-only snapshot/restore surface.
    match /recoveryVault/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }
    match /recoveryMeta/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- Edit leases (CONCURRENCY PHASE 1b, session-check hardened in PHASE
    // 7b / PH7-27). A transient "one active editor per record" coordination
    // lock. lockId = "<collection>__<docId>". This is a UX mechanism ONLY —
    // the authoritative data-integrity layer is the Phase 1a `_rev`
    // transaction on the record itself, which is unchanged. These rules exist
    // so the lock cannot be stolen or corrupted from a raw client:
    //
    //   CREATE  — any signed-in user, but only for THEMSELVES, with a valid
    //             expiry no more than 3 minutes out (a client can't claim a
    //             record forever by writing a far-future expiresAt).
    //   UPDATE  — the CURRENT holder (BOTH ownerUid AND sessionId matching
    //             the document as it stands right now — not uid alone) may
    //             renew (a future expiresAt, same as create) OR release (an
    //             ALREADY-PAST expiresAt, signaling "I'm done") — OR any
    //             signed-in user may take over a lease that has already
    //             EXPIRED (by server time), becoming the new owner with a
    //             fresh future expiry.
    //   DELETE  — an already-expired lease only. A lease is now RELEASED by
    //             updating it to a past expiresAt (see UPDATE above), not by
    //             deleting it — a Firestore `delete` carries no payload for
    //             the rules to check a session identity against, so it can
    //             never be made session-aware; restricting delete to
    //             already-expired documents closes that path entirely rather
    //             than trying to patch it. lib/editLease.js's releaseLease no
    //             longer calls delete for this reason (see its own comment).
    //
    //   PH7-27 (Phase 7 discovery): before this, a same-uid client that
    //   bypassed lib/editLease.js's own session-aware transaction (talked to
    //   Firestore directly) could overwrite OR delete its own other tab's
    //   ACTIVE lease purely on ownerUid match — ownedByMe() alone was never
    //   enough for "only the session that actually holds it may change it".
    //   This closes that gap at the rules layer to match what
    //   lib/editLease.js's client transaction already enforced for update,
    //   and closes it more strictly than that for delete (see above).
    match /editLocks/{lockId} {
      function ownedByMe() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      // Session continuity — only meaningful once ownedByMe() already holds
      // (same uid); this is the extra check PH7-27 adds. A brand-new lease
      // (no `resource` yet, i.e. create) or a takeover of an expired one
      // never reaches this — see the update rule below.
      function sameSession() {
        return resource.data.sessionId == request.resource.data.sessionId;
      }
      function expired() {
        return resource.data.expiresAt is timestamp && resource.data.expiresAt < request.time;
      }
      // A genuine claim (create, or renew/takeover via update): own identity,
      // a real future expiry capped at 3 minutes out (a client can't claim a
      // record forever by writing a far-future expiresAt).
      function incomingShapeOk() {
        return request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.sessionId is string
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt < request.time + duration.value(3, 'm');
      }
      // An explicit release: own identity, but the expiry is deliberately
      // NOT in the future — the opposite shape from a claim. Only reachable
      // by the current session releasing itself (see the update rule below);
      // never lets a claim smuggle a stale expiresAt past incomingShapeOk().
      function releaseShapeOk() {
        return request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.sessionId is string
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time;
      }
      allow read:   if signedIn();
      allow create: if signedIn() && incomingShapeOk();
      allow update: if signedIn() && (
        (expired() && incomingShapeOk()) ||
        (ownedByMe() && sameSession() && (incomingShapeOk() || releaseShapeOk()))
      );
      allow delete: if signedIn() && expired();
    }

    // ---- Document-number counters (CONCURRENCY PHASE 2). One doc per sequence
    // (counters/invoices, counters/estimates): { next: <int> }. Allocation is a
    // client transaction (lib/docCounter.js) that reads `next`, hands it out and
    // writes `next + 1` in the same transaction — so two terminals billing at the
    // same moment can never receive the same invoice number.
    //
    //   READ    — any signed-in user (the allocator must read the current value).
    //   CREATE  — any signed-in user, first allocation only, `next` a positive int.
    //   UPDATE  — any signed-in user, but `next` may NEVER DECREASE. That is the
    //             safety property: a stale or malicious client cannot reset the
    //             counter low and cause duplicate serials. No other field may be
    //             written (hasOnly(['next'])).
    //             `>=` (not `>`): under transaction contention the Firestore
    //             emulator/back end rule-checks a losing attempt's commit BEFORE
    //             its version-conflict retry; a strict `>` would turn that
    //             abort-and-retry into a terminal permission-denied. `>=` lets the
    //             doomed no-op write pass rules so the transaction aborts+retries
    //             normally, and monotonicity is still guaranteed (a retry always
    //             re-reads the higher value and writes higher again).
    //   DELETE  — never. Losing the counter would restart the sequence at 1.
    //
    // Single-shop trust model: any signed-in user may advance the counter, exactly
    // as any signed-in user may already create invoices.
    match /counters/{sequence} {
      allow read:   if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next >= 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next >= resource.data.next;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
